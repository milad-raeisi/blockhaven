# ---------------------------------------------------------------------------
# Blockhaven configuration. Copy to `.env` and adjust as needed.
# ---------------------------------------------------------------------------

# PostgreSQL connection (docker-compose maps the container to localhost:5434).
DATABASE_URL="postgresql://blockhaven:blockhaven@localhost:5434/blockhaven?schema=public"
# Database used by `pnpm test:integration` (created automatically by docker-compose).
TEST_DATABASE_URL="postgresql://blockhaven:blockhaven@localhost:5434/blockhaven_test?schema=public"

# Values used by docker-compose for the database container.
POSTGRES_USER=blockhaven
POSTGRES_PASSWORD=blockhaven
POSTGRES_DB=blockhaven
POSTGRES_PORT=5434

# Interface and port of the game server. 0.0.0.0 makes it reachable from the LAN.
HOST=0.0.0.0
PORT=3000

# Secret used to sign guest session tokens. Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Extra origins allowed to open WebSocket connections (comma separated).
# Same-host origins are always allowed, so this is usually empty.
ALLOWED_ORIGINS=""

# Set to "true" when serving the game behind an HTTPS reverse proxy (secure cookies).
SECURE_COOKIES=false

# Simulation tick rate (ticks per second).
TICK_RATE=20
# How often dirty chunks and player data are flushed to PostgreSQL (milliseconds).
SAVE_INTERVAL_MS=10000
# Maximum chunk radius a client may request.
MAX_RENDER_DISTANCE=12
# Seconds an empty world stays loaded in memory before it is saved and unloaded.
ROOM_IDLE_UNLOAD_SECONDS=60

# debug | info | warn | error
LOG_LEVEL=info
